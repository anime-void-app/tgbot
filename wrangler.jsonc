{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "funtime-raid-bridge",
  "main": "src/index.js",
  "compatibility_date": "2026-11-25",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "BRIDGE",
        "class_name": "VkBridge"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["VkBridge"]
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
